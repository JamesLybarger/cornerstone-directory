# Stripe — get these from dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Stripe Webhook Secret — get from dashboard.stripe.com/webhooks after adding your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Separate Stripe webhook for marketplace purchases
STRIPE_MARKETPLACE_WEBHOOK_SECRET=whsec_...

# Required in production. Generate a unique random value of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret

# Temporary one-time administrator recovery token. Remove after admin access is restored.
ADMIN_RECOVERY_TOKEN=remove-after-recovery

# Cloudflare R2 storage for marketplace files
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=cornerstone-marketplace-files

# Your live domain once deployed
APP_URL=https://cornerstonedirectory.com

# Set to production on Railway
NODE_ENV=production

# Port — Railway sets this automatically, but 5000 is the default
PORT=5000
